+                n_ba=self.in_proj_ba.output_size_per_partition,
+                qkv_dim=self.conv_dim // self.tp_size,
+                num_qk_heads=self.num_k_heads // self.tp_size,
+                num_v_heads=divide(self.num_v_heads, self.tp_size),
